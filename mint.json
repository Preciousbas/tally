  "navigation": [
    {
      "group": "The desk",
      "pages": [
        "docs/index",
        "docs/how-it-works",
        "docs/privacy",
        "docs/desk-tour",
        "docs/quickstart",
        "docs/preprod"
      ]
    },
    {
      "group": "Internals",
      "pages": [
        "docs/architecture",
        "docs/contract",
        "docs/identity"
      ]
    },
    {
      "group": "Contribute",
      "pages": [
        "docs/design-system",
        "docs/contributing",
        "docs/demo"
      ]
    }
  ],
  "footerSocials": {
    "x": "https://x.com/tally_lend",
    "github": "https://github.com/Preciousbas/tally"
  }
}
