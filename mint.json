{
  "$schema": "https://mintlify.com/schema.json",
  "name": "Tally",
  "logo": {
    "dark": "/docs/images/tally-stick.svg",
    "light": "/docs/images/tally-stick.svg"
  },
  "favicon": "/docs/favicon.svg",
  "colors": {
    "primary": "#8C2F2B",
    "dark": "#8C2F2B",
    "light": "#8C2F2B",
    "background": {
      "dark": "#1C1914"
    }
  },
  "modeToggle": {
    "default": "dark"
  },
  "font": {
    "headings": {
      "family": "Fraunces"
    },
    "body": {
      "family": "Figtree"
    }
  },
  "topbarLinks": [
