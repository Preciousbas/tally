{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Tally",
  "description": "Private bilateral trade credit on Midnight.",
  "colors": {
    "primary": "#8C2F2B",
    "light": "#8C2F2B",
    "dark": "#8C2F2B",
    "background": {
      "light": "#E8DCC8",
      "dark": "#1C1914"
    }
  },
  "fonts": {
    "family": "Figtree",
    "heading": {
      "family": "Fraunces"
    }
  },
  "logo": {
    "light": "/images/tally-stick.svg",
    "dark": "/images/tally-stick.svg",
    "href": "https://tally-jet-mu.vercel.app"
  },
  "favicon": "/favicon.svg",
  "css": ["/custom.css"],
  "appearance": {
    "default": "dark",
    "strict": false
  },
  "styling": {
    "eyebrows": "breadcrumbs",
    "codeblocks": "dark"
  },
  "icons": {
    "library": "lucide"
  },
  "navbar": {
    "links": [
      {
        "label": "GitHub",
        "href": "https://github.com/Preciousbas/tally"
      },
      {
        "label": "llms.txt",
        "href": "/llms.txt"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Open desk",
      "href": "https://tally-jet-mu.vercel.app"
    }
  },
  "footer": {
    "socials": {
      "x": "https://x.com/tally_midnight",
      "github": "https://github.com/Preciousbas/tally"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Use",
        "icon": "book-open",
        "groups": [
          {
            "group": "Use",
            "pages": [
              "index",
              "desk",
              "lifecycle",
              "privacy",
              "standing"
            ]
          }
        ]
      },
      {
        "tab": "Build",
        "icon": "blocks",
        "groups": [
          {
            "group": "Build",
            "pages": [
              "overview",
              "quickstart",
              "preprod",
              "architecture",
              "identity",
              "contract"
            ]
          }
        ]
      },
      {
        "tab": "Reference",
        "icon": "library",
        "groups": [
          {
            "group": "Reference",
            "pages": [
              "glossary",
              "design-system",
              "demo"
            ]
          }
        ]
      }
    ]
  },
  "redirects": [
    {
      "source": "/privacy-model",
      "destination": "/privacy"
    },
    {
      "source": "/concepts/privacy-model",
      "destination": "/privacy"
    },
    {
      "source": "/concepts/loan-lifecycle",
      "destination": "/lifecycle"
    },
    {
      "source": "/how-it-works",
      "destination": "/lifecycle"
    },
    {
      "source": "/desk-tour",
      "destination": "/desk"
    },
    {
      "source": "/concepts/standing",
      "destination": "/standing"
    },
    {
      "source": "/concepts/glossary",
      "destination": "/glossary"
    },
    {
      "source": "/concepts/identity",
      "destination": "/identity"
    },
    {
      "source": "/concepts/architecture",
      "destination": "/architecture"
    },
    {
      "source": "/reference/contract-api",
      "destination": "/contract"
    },
    {
      "source": "/verify/overview",
      "destination": "/standing"
    },
    {
      "source": "/resources/llms",
      "destination": "/llms.txt"
    }
  ]
}
