{
  "$schema": "https://mintlify.com/schema.json",
  "name": "Tally",
  "logo": {
    "dark": "/images/tally-stick.svg",
    "light": "/images/tally-stick.svg"
  },
  "favicon": "/favicon.svg",
  "colors": {
    "primary": "#8C2F2B",
    "dark": "#8C2F2B",
    "light": "#8C2F2B",
    "background": {
      "dark": "#1C1914",
      "light": "#E8DCC8"
    }
  },
  "modeToggle": {
    "default": "dark"
  },
  "font": {
    "headings": {
      "family": "Fraunces"
    },
    "body": {
      "family": "Figtree"
    }
  },
  "topbarLinks": [
    {
      "name": "GitHub",
      "url": "https://github.com/Preciousbas/tally"
    }
  ],
  "topbarCtaButton": {
    "name": "Open desk",
    "url": "https://tally-jet-mu.vercel.app"
  },
  "tabs": [
    {
      "name": "Use",
      "url": "index"
    },
    {
      "name": "Build",
      "url": "overview"
    }
  ],
  "navigation": [
    {
      "group": "Use",
      "pages": ["index", "desk", "lifecycle", "privacy", "standing"]
    },
    {
      "group": "Build",
      "pages": ["overview", "quickstart", "preprod", "architecture", "identity", "contract"]
    },
    {
      "group": "Reference",
      "pages": ["glossary", "design-system", "demo"]
    }
  ],
  "footerSocials": {
    "x": "https://x.com/tally_midnight",
    "github": "https://github.com/Preciousbas/tally"
  }
}
