{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "Tally",
  "description": "Private bilateral trade credit on Midnight.",
  "colors": {
    "primary": "#8C2F2B",
    "light": "#8C2F2B",
    "dark": "#8C2F2B"
  },
  "fonts": {
    "family": "Figtree",
    "heading": {
      "family": "Fraunces"
    }
  },
  "logo": {
    "light": "/docs/images/tally-stick.svg",
    "dark": "/docs/images/tally-stick.svg",
    "href": "https://tally-jet-mu.vercel.app"
  },
  "favicon": "/docs/favicon.svg",
  "appearance": {
    "default": "dark",
    "strict": false
  },
  "styling": {
    "eyebrows": "breadcrumbs",
    "codeblocks": "dark"
  },
  "icons": {
    "library": "lucide"
  },
  "navbar": {
    "links": [
      {
        "label": "GitHub",
        "href": "https://github.com/Preciousbas/tally"
      }
    ],
    "primary": {
      "type": "link",
      "label": "Open desk",
      "href": "https://tally-jet-mu.vercel.app"
    }
  },
  "footer": {
    "socials": {
      "x": "https://x.com/tally_midnight",
      "github": "https://github.com/Preciousbas/tally"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Use",
        "groups": [
          {
            "group": "The desk",
            "pages": [
              "docs/index",
              "docs/how-it-works",
              "docs/privacy",
              "docs/desk-tour",
              "docs/quickstart",
              "docs/preprod"
            ]
          }
        ]
      },
      {
        "tab": "Build",
        "groups": [
          {
            "group": "Internals",
            "pages": [
              "docs/architecture",
              "docs/contract",
              "docs/identity"
            ]
          },
          {
            "group": "Contribute",
            "pages": [
              "docs/design-system",
              "docs/contributing",
              "docs/demo"
            ]
          }
        ]
      }
    ]
  },
  "redirects": [
    {
      "source": "/privacy-model",
      "destination": "/docs/privacy"
    }
  ]
}
